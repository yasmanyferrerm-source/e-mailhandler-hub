# Google OAuth client IDs (see README → "Set up Google sign-in").
# Leave them empty to run the app in demo mode with sample mail.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Desktop app client (Google requires its secret; it is not confidential for installed apps).
EXPO_PUBLIC_GOOGLE_DESKTOP_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_DESKTOP_CLIENT_SECRET=
